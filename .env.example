# Server
NODE_ENV=development
PORT=4000
PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuba_club?schema=public"

# JWT Secrets
JWT_SECRET="nuba_club_super_secret_access_key_change_in_prod_2026"
JWT_REFRESH_SECRET="nuba_club_super_secret_refresh_key_change_in_prod_2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS
FRONTEND_URL="http://localhost:3000"

# External Nuba Ecosystem APIs
FLEX_STREAMING_API_URL="https://api-streamflex.unixxtech.online/api"
NEXOPLAY_API_URL="https://nexoplay-api.unixxtech.online/api"
NUBATV_API_URL="https://nubatv-api.unixxtech.online/api"

# TMDB
TMDB_API_KEY="your_tmdb_api_key_here"
